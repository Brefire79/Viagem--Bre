rules_version = '2';

// =============================================================================
// NOTA DE SEGURANCA (v1 - uso familiar/pequeno):
// A regra `isPendingInvite` usada em `match /trips/{tripId} -> allow update`
// e necessaria porque, em src/contexts/AuthContext.jsx, o usuario se
// auto-adiciona ao array `participants` ao logar/registrar com um convite
// pendente. Porem, do jeito atual, ela permite que um convidado pendente
// faca QUALQUER update na trip - nao apenas aceitar o convite.
// Para uso familiar/pequeno isto e aceitavel como v1.
// A medio prazo, a aceitacao de convite deve migrar para uma Cloud Function.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isParticipant(tripId) {
      return isSignedIn() && request.auth.uid in tripData(tripId).participants;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    // ===== TRIPS =====
    match /trips/{tripId} {
      // Convidado pendente identificado pelo e-mail do token de auth
      function isPendingInvite() {
        return isSignedIn() &&
               request.auth.token.email != null &&
               request.auth.token.email.lower() in resource.data.get('pendingParticipants', []);
      }

      allow read: if isParticipant(tripId) || isPendingInvite();

      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.createdBy &&
                       request.auth.uid in request.resource.data.participants;

      // Participante pode atualizar, desde que NAO remova o criador da lista.
      // Convidado pendente pode atualizar para aceitar o convite (ver NOTA acima).
      allow update: if (isParticipant(tripId) &&
                        resource.data.createdBy in request.resource.data.participants)
                       || isPendingInvite();

      allow delete: if isOwner(resource.data.createdBy);
    }

    // ===== EVENTS =====
    match /events/{eventId} {
      allow read: if isParticipant(resource.data.tripId);
      allow create: if isSignedIn() &&
                       isParticipant(request.resource.data.tripId) &&
                       request.auth.uid == request.resource.data.createdBy;
      allow update: if isParticipant(resource.data.tripId);
      allow delete: if isOwner(resource.data.createdBy);
    }

    // ===== EXPENSES =====
    match /expenses/{expenseId} {
      allow read: if isParticipant(resource.data.tripId);
      allow create: if isSignedIn() &&
                       isParticipant(request.resource.data.tripId) &&
                       request.resource.data.paidBy in tripData(request.resource.data.tripId).participants &&
                       request.resource.data.amount > 0;
      allow update: if isParticipant(resource.data.tripId) &&
                       request.resource.data.amount > 0;
      allow delete: if isParticipant(resource.data.tripId);
    }

    // Bloquear qualquer outra coleccao
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
